{
  "name": "formos",
  "version": "0.0.0",
  "private": true,
  "description": "FORMOS — modular-monolith multi-tenant form platform (Phase 0 foundation)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "guards": "node scripts/guards/architecture-guards.mjs",
    "build:libs": "npm run build --workspace @formos/domain --workspace @formos/config --workspace @formos/auth --workspace @formos/database --workspace @formos/forms-engine --workspace @formos/renderer --workspace @formos/builder --workspace @formos/ui",
    "build": "npm run build --workspace @formos/web",
    "ci": "npm run build:libs && npm run typecheck && npm run lint && npm run guards && npm run test && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^26.6.5",
    "eslint": "^9.24.0",
    "globals": "^17.13.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.3",
    "zod": "^3.24.3"
  },
  "engines": {
    "node": ">=20"
  }
}
